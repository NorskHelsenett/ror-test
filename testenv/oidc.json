      {"requestParam": "client_id", "match": "grant-reader", "claims": {"sub": "grant-reader", "aud": ["ror-e2e"], "email": "grant-reader@e2e.invalid", "email_verified": true, "groups": ["admins"], "ror_grants": [{"scope": "KubernetesCluster", "subject": "11111111-1111-4111-8111-111111111111", "access": ["ror:read"]}]}},
