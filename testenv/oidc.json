      {"requestParam": "client_id", "match": "reader", "claims": {"sub": "reader", "aud": ["ror-e2e"], "email": "reader@e2e.invalid", "email_verified": true, "groups": ["readers"]}},
      {"requestParam": "client_id", "match": "outsider", "claims": {"sub": "outsider", "aud": ["ror-e2e"], "email": "outsider@e2e.invalid", "email_verified": true, "groups": ["outsiders"]}}
    ]
  }]
}