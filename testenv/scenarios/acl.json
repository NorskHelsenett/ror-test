{
  "version": 1,
  "name": "ACL and cluster resource contract v3",
  "vars": {"CLUSTER_A": "11111111-1111-4111-8111-111111111111", "CLUSTER_B": "22222222-2222-4222-8222-222222222222", "CLUSTER_A_KEY": "e2e-cluster-a-synthetic-only", "CLUSTER_B_KEY": "e2e-cluster-b-synthetic-only", "SERVICE_KEY": "e2e-service-synthetic-only", "POD_A": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "DEPLOYMENT_A": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaab", "POD_B": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb", "DEPLOYMENT_B": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbc"},
  "steps": [
    {"name": "anonymous denied", "method": "HEAD", "path": "/v2/acl/lookup/KubernetesCluster/${CLUSTER_A}/ror:read", "status": 401},
    {"name": "invalid token denied", "method": "HEAD", "path": "/v2/acl/lookup/KubernetesCluster/${CLUSTER_A}/ror:read", "headers": {"Authorization": "Bearer invalid"}, "status": 401},
    {"name": "reader own cluster", "method": "HEAD", "path": "/v2/acl/lookup/KubernetesCluster/${CLUSTER_A}/ror:read", "headers": {"Authorization": "Bearer ${READER_TOKEN}"}, "status": 200, "responseHeaders": {"Cache-Control": "no-store, no-cache, must-revalidate"}},
    {"name": "reader other cluster denied", "method": "HEAD", "path": "/v2/acl/lookup/KubernetesCluster/${CLUSTER_B}/ror:read", "headers": {"Authorization": "Bearer ${READER_TOKEN}"}, "status": 403},
    {"name": "reader write denied", "method": "HEAD", "path": "/v2/acl/lookup/KubernetesCluster/${CLUSTER_A}/ror:update", "headers": {"Authorization": "Bearer ${READER_TOKEN}"}, "status": 403},
    {"name": "outsider denied", "method": "HEAD", "path": "/v2/acl/lookup/KubernetesCluster/${CLUSTER_A}/ror:read", "headers": {"Authorization": "Bearer ${OUTSIDER_TOKEN}"}, "status": 403},
    {"name": "create V3 grant", "method": "POST", "path": "/v2/acl", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"version": 3, "group": "created@e2e.invalid", "scope": "ror", "subject": "Config", "access": ["ror:config:read"]}, "status": 200, "capture": {"ACL_ID": "/id"}, "equals": {"/version": 3, "/access": ["ror:config:read"]}, "ignore": ["/created"]},
    {"name": "read V3 grant", "method": "GET", "path": "/v2/acl/${ACL_ID}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/id": "${ACL_ID}", "/access": ["ror:config:read"]}, "ignore": ["/created"]},
    {"name": "update V3 grant", "method": "PUT", "path": "/v2/acl/${ACL_ID}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"version": 3, "group": "created@e2e.invalid", "scope": "ror", "subject": "Config", "access": ["ror:config:read", "ror:config:write"]}, "status": 200, "equals": {"/access": ["ror:config:read", "ror:config:write"]}, "ignore": ["/created"]},
    {"name": "delete V3 grant", "method": "DELETE", "path": "/v2/acl/${ACL_ID}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"": true}},
    {"name": "cluster A updates itself", "method": "PATCH", "path": "/v2/resources/uid/${CLUSTER_A}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-cluster-a"}}}, "status": 200},
    {"name": "cluster A reads its persisted update", "method": "GET", "path": "/v2/resources/uid/${CLUSTER_A}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "status": 200, "equals": {"/0/kind": "KubernetesCluster", "/0/metadata/uid": "${CLUSTER_A}", "/0/metadata/labels/e2e-update": "updated-by-cluster-a"}},
    {"name": "cluster A updates its Pod", "method": "PATCH", "path": "/v2/resources/uid/${POD_A}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-cluster-a"}}}, "status": 200},
    {"name": "cluster A reads its persisted Pod update", "method": "GET", "path": "/v2/resources/uid/${POD_A}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "status": 200, "equals": {"/0/kind": "Pod", "/0/metadata/uid": "${POD_A}", "/0/metadata/labels/e2e-update": "updated-by-cluster-a"}},
    {"name": "cluster A updates its Deployment", "method": "PATCH", "path": "/v2/resources/uid/${DEPLOYMENT_A}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-cluster-a"}}}, "status": 200},
    {"name": "cluster A reads its persisted Deployment update", "method": "GET", "path": "/v2/resources/uid/${DEPLOYMENT_A}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "status": 200, "equals": {"/0/kind": "Deployment", "/0/metadata/uid": "${DEPLOYMENT_A}", "/0/metadata/labels/e2e-update": "updated-by-cluster-a"}},
    {"name": "cluster A cannot update cluster B", "method": "PATCH", "path": "/v2/resources/uid/${CLUSTER_B}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "body": {"metadata": {"labels": {"e2e-update": "unauthorized-change"}}}, "status": 404},
    {"name": "cluster B remains unchanged", "method": "GET", "path": "/v2/resources/uid/${CLUSTER_B}", "headers": {"X-API-KEY": "${CLUSTER_B_KEY}"}, "status": 200, "equals": {"/0/kind": "KubernetesCluster", "/0/metadata/uid": "${CLUSTER_B}", "/0/metadata/labels/e2e-update": "original"}},
    {"name": "cluster A cannot update cluster B Pod", "method": "PATCH", "path": "/v2/resources/uid/${POD_B}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "body": {"metadata": {"labels": {"e2e-update": "unauthorized-change"}}}, "status": 404},
    {"name": "cluster B Pod remains unchanged", "method": "GET", "path": "/v2/resources/uid/${POD_B}", "headers": {"X-API-KEY": "${CLUSTER_B_KEY}"}, "status": 200, "equals": {"/0/kind": "Pod", "/0/metadata/uid": "${POD_B}", "/0/metadata/labels/e2e-update": "original"}},
    {"name": "cluster A cannot update cluster B Deployment", "method": "PATCH", "path": "/v2/resources/uid/${DEPLOYMENT_B}", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "body": {"metadata": {"labels": {"e2e-update": "unauthorized-change"}}}, "status": 404},
    {"name": "cluster B Deployment remains unchanged", "method": "GET", "path": "/v2/resources/uid/${DEPLOYMENT_B}", "headers": {"X-API-KEY": "${CLUSTER_B_KEY}"}, "status": 200, "equals": {"/0/kind": "Deployment", "/0/metadata/uid": "${DEPLOYMENT_B}", "/0/metadata/labels/e2e-update": "original"}},
    {"name": "admin updates cluster A", "method": "PATCH", "path": "/v2/resources/uid/${CLUSTER_A}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-admin"}}}, "status": 200},
    {"name": "admin reads persisted cluster A update", "method": "GET", "path": "/v2/resources/uid/${CLUSTER_A}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/0/kind": "KubernetesCluster", "/0/metadata/uid": "${CLUSTER_A}", "/0/metadata/labels/e2e-update": "updated-by-admin"}},
    {"name": "admin updates cluster A Pod", "method": "PATCH", "path": "/v2/resources/uid/${POD_A}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-admin"}}}, "status": 200},
    {"name": "admin reads persisted cluster A Pod update", "method": "GET", "path": "/v2/resources/uid/${POD_A}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/0/kind": "Pod", "/0/metadata/uid": "${POD_A}", "/0/metadata/labels/e2e-update": "updated-by-admin"}},
    {"name": "admin updates cluster A Deployment", "method": "PATCH", "path": "/v2/resources/uid/${DEPLOYMENT_A}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-admin"}}}, "status": 200},
    {"name": "admin reads persisted cluster A Deployment update", "method": "GET", "path": "/v2/resources/uid/${DEPLOYMENT_A}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/0/kind": "Deployment", "/0/metadata/uid": "${DEPLOYMENT_A}", "/0/metadata/labels/e2e-update": "updated-by-admin"}},
    {"name": "admin updates cluster B", "method": "PATCH", "path": "/v2/resources/uid/${CLUSTER_B}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-admin"}}}, "status": 200},
    {"name": "admin reads persisted cluster B update", "method": "GET", "path": "/v2/resources/uid/${CLUSTER_B}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/0/kind": "KubernetesCluster", "/0/metadata/uid": "${CLUSTER_B}", "/0/metadata/labels/e2e-update": "updated-by-admin"}},
    {"name": "admin updates cluster B Pod", "method": "PATCH", "path": "/v2/resources/uid/${POD_B}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-admin"}}}, "status": 200},
    {"name": "admin reads persisted cluster B Pod update", "method": "GET", "path": "/v2/resources/uid/${POD_B}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/0/kind": "Pod", "/0/metadata/uid": "${POD_B}", "/0/metadata/labels/e2e-update": "updated-by-admin"}},
    {"name": "admin updates cluster B Deployment", "method": "PATCH", "path": "/v2/resources/uid/${DEPLOYMENT_B}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "body": {"metadata": {"labels": {"e2e-update": "updated-by-admin"}}}, "status": 200},
    {"name": "admin reads persisted cluster B Deployment update", "method": "GET", "path": "/v2/resources/uid/${DEPLOYMENT_B}", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/0/kind": "Deployment", "/0/metadata/uid": "${DEPLOYMENT_B}", "/0/metadata/labels/e2e-update": "updated-by-admin"}},
    {"name": "self anonymous denied", "method": "GET", "path": "/v2/self", "status": 401},
    {"name": "self invalid token denied", "method": "GET", "path": "/v2/self", "headers": {"Authorization": "Bearer invalid"}, "status": 401},
    {"name": "self admin user shape", "method": "GET", "path": "/v2/self", "headers": {"Authorization": "Bearer ${ADMIN_TOKEN}"}, "status": 200, "equals": {"/type": "User", "/auth/authProvider": "OIDC", "/auth/authProviderId": "admin@e2e.invalid", "/user": {"email": "admin@e2e.invalid", "groups": ["admins@e2e.invalid"]}}, "ignore": ["/auth/expirationTime"]},
    {"name": "self reader user shape", "method": "GET", "path": "/v2/self", "headers": {"Authorization": "Bearer ${READER_TOKEN}"}, "status": 200, "equals": {"/type": "User", "/auth/authProvider": "OIDC", "/auth/authProviderId": "reader@e2e.invalid", "/user": {"email": "reader@e2e.invalid", "groups": ["readers@e2e.invalid"]}}, "ignore": ["/auth/expirationTime"]},
    {"name": "self outsider authenticates without grants", "method": "GET", "path": "/v2/self", "headers": {"Authorization": "Bearer ${OUTSIDER_TOKEN}"}, "status": 200, "equals": {"/type": "User", "/auth/authProvider": "OIDC", "/user": {"email": "outsider@e2e.invalid", "groups": ["outsiders@e2e.invalid"]}}, "ignore": ["/auth/expirationTime"]},
    {"name": "self cluster A shape", "method": "GET", "path": "/v2/self", "headers": {"X-API-KEY": "${CLUSTER_A_KEY}"}, "status": 200, "equals": {"/type": "Cluster", "/auth/authProvider": "APIKEY", "/auth/authProviderId": "e2e-cluster-a", "/auth/expirationTime": "2099-01-01T00:00:00Z", "/user": {"name": "e2e-cluster-a", "uid": "${CLUSTER_A}"}}},
    {"name": "self cluster B shape", "method": "GET", "path": "/v2/self", "headers": {"X-API-KEY": "${CLUSTER_B_KEY}"}, "status": 200, "equals": {"/type": "Cluster", "/auth/authProvider": "APIKEY", "/auth/authProviderId": "e2e-cluster-b", "/user": {"name": "e2e-cluster-b", "uid": "${CLUSTER_B}"}}, "ignore": ["/auth/expirationTime"]},
    {"name": "self service shape", "method": "GET", "path": "/v2/self", "headers": {"X-API-KEY": "${SERVICE_KEY}"}, "status": 200, "equals": {"/type": "Service", "/auth/authProvider": "APIKEY", "/auth/authProviderId": "e2e-service", "/auth/expirationTime": "2099-01-01T00:00:00Z", "/user": {"name": "e2e-service"}}}
  ]
}